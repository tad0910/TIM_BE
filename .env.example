# File .env.example (Mẫu cấu hình môi trường)

# Server
PORT=8081

# Database (Local)
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=dbtest
MYSQLUSER=root
MYSQLPASSWORD=your_db_password

# Keycloak
KEYCLOK_SERVER=https://id.dev.codegym.vn/auth
KEYCLOAK_REALM=codegym-software-nhom-4
KEYCLOAK_CLIENT_ID=tim_app
KEYCLOAK_CLIENT_SECRET=your_keycloak_secret
KEYCLOAK_ISSUER=https://id.dev.codegym.vn/auth/realms/codegym-software-nhom-4
KEYCLOAK_INTROSPECT=https://id.dev.codegym.vn/auth/realms/codegym-software-nhom-4/protocol/openid-connect/token/introspect

# Email (SMTP)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# Bảo mật (Pepper)
APP_PEPPER=your_pepper_secret_key

# CORS (Cho Frontend local)
SPRING_WEB_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Upload (Cho local)
upload_folder=D:/BE-Project/ALM-Team-Tim-BE/uploads
