UPDATE `class_module_teacher`
  SET `role` = 'TEACHER'
  WHERE `role` IN ('MAIN','ASSISTANT','MENTOR');

UPDATE `class_module_schedule_teacher`
  SET `role` = 'TEACHER'
  WHERE `role` IN ('LECTURER','SUPPORTER','OBSERVER');

ALTER TABLE `class_module_teacher`
  MODIFY COLUMN `role` ENUM('TEACHER') NOT NULL DEFAULT 'TEACHER';

ALTER TABLE `class_module_schedule_teacher`
  MODIFY COLUMN `role` ENUM('TEACHER') NOT NULL DEFAULT 'TEACHER';
  

